#: php/SettingsController.php:137
msgid "API Token (Recommended)"
msgstr "API-token (aanbevolen)"

#: php/SettingsController.php:140
msgid "Cloudflare recommends using API Tokens for improved security and better access control. API Tokens use Bearer authentication."
msgstr "Cloudflare raadt aan om API-tokens te gebruiken voor betere beveiliging en beter toegangsbeheer. API-tokens gebruiken Bearer-authenticatie."

#: php/SettingsController.php:148
msgid "API Token"
msgstr "API-token"

#: php/SettingsController.php:162
msgid "Global API Key (Legacy)"
msgstr "Globale API-sleutel (verouderd)"

#: php/SettingsController.php:165
msgid "The Global API Key authentication method is still supported but not recommended. If an API Token is configured, it will be used instead."
msgstr "De authenticatiemethode met de globale API-sleutel wordt nog ondersteund, maar wordt niet aanbevolen. Als er een API-token is ingesteld, wordt deze in plaats daarvan gebruikt."

#: php/SettingsController.php:173
msgid "API email"
msgstr "API-e-mailadres"

#: php/SettingsController.php:187
msgid "API key"
msgstr "API-sleutel"

#. translators: 1: Constant name, 2: wp-config.php..
#: php/SettingsController.php:233
#, php-format
msgid "This value is defined in the named constant %1$s, probably in the WordPress configuration file %2$s."
msgstr "Deze waarde is gedefinieerd in de constante %1$s, waarschijnlijk in het WordPress-configuratiebestand %2$s."
