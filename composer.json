{
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true,
			"composer/installers": true
		},
		"sort-packages": true,
		"wp-slug": "pronamic-cloudflare"
	},
	"autoload": {
		"psr-4": {
			"Pronamic\\WordPressCloudflare\\": "php/"
		}
	},
	"repositories": [
		{
			"name": "wp-packages",
			"type": "composer",
			"url": "https://repo.wp-packages.org"
		}
	],
	"require": {
		"automattic/jetpack-autoloader": "^6.0",
		"pronamic/wp-html": "^2.2",
		"woocommerce/action-scheduler": "^4.2"
	},
	"require-dev": {
		"pronamic/pronamic-cli": "^1.1",
		"pronamic/wp-coding-standards": "^2.3",
		"roots/wordpress-no-content": "^7.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli": "*",
		"wp-plugin/cloudflare": "^4.14"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-cloudflare/",
			"vendor/bin/wp i18n make-pot ./build/pronamic-cloudflare/ --slug=pronamic-cloudflare",
			"vendor/bin/wp i18n make-mo ./build/pronamic-cloudflare/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-cloudflare/ --plugin-dirname=pronamic-cloudflare --force"
		],
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-cloudflare/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-cloudflare.pot"
		],
		"phpcbf": "XDEBUG_MODE=off vendor/bin/phpcbf",
		"phpcs": "XDEBUG_MODE=off vendor/bin/phpcs -s -v"
	}
}
